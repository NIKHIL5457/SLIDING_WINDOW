class Solution {
  public:
    int findSubarray(vector<int> &arr) {
        unordered_map<int,int> mp;
        int count=0;
        int prefix=0;
        mp[0]=1;
        for(int i=0;i<arr.size();i++){
            prefix+=arr[i];
            if(mp.count(prefix)){
                count+=mp[prefix];
                mp[prefix]++;
            }else{
                 mp[prefix]=1;
            }
        }
        return count;
