https://leetcode.com/problems/subarray-product-less-than-k/description/
class Solution {
public:
    int numSubarrayProductLessThanK(vector<int>& nums, int k) {
        int first=0,second=0;
        int prefixprod=1,count=0;
        int n=nums.size();
        while(second<n){
            prefixprod=prefixprod*nums[second];
            while(prefixprod>=k && first<=second){
                prefixprod/=nums[first];
                first++;
            }
             count+=second-first+1;
            second++;
           
            
        }
        return count;
    }
};
