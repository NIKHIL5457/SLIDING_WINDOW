class Solution {
  public:
    int findSubString(string& str) {
        // code here
        int first=0,second=0,smallest=str.size();
        int diff=0;
        vector<int>count(256,0);
        
        for(int i=0;i<str.size();i++){
            if(count[str[i]]==0){
                diff++;
                count[str[i]]=1;
            }
        }
        while(first<count.size()) count[first++]=0;
        
        first=0;
       while(second<str.size()){
            while(diff && second<str.size()){
            if(count[str[second]]==0){
                diff--;
            }
            count[str[second]]++;
            second++;
        }
        smallest=min(smallest,second-first);
        while(diff!=1){
            smallest=min(smallest,second-first);
            count[str[first]]--;
            if(count[str[first]]==0){
                diff++;
            }
            first++;
        }
       }
        return smallest;
    
    }
};
